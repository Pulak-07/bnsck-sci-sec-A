{
  "version": 2,
  "builds": [
    {
      "src": "bnsck_hsc_2027_science_section_a.html",
      "use": "@vercel/static"
    }
  ],
  "headers": [
    {
      "source": "/bnsck_hsc_2027_science_section_a.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/bnsck_hsc_2027_science_section_a.html"
    },
    {
      "src": "/(.*)",
      "dest": "/bnsck_hsc_2027_science_section_a.html"
    }
  ]
}
